@page "/about"

@using BigBang1112.GbxTools.Titles.Services
@inject TitleArchiveStatus ArchiveStatus

<ReuContainer>
    <h2>About</h2>

    <p>
        <b>Title Archive</b> (titles.gbx.tools) is an enhanced ManiaPlanet title pack browser focused on archiving.
        The project is fully open-source and you will be soon able to archive locally using the desktop application.
    </p>
    <p>
        You can use the application for various purposes:
        <ul>
            <li>Search title packs by name</li>
            <li>Manually download title packs if the ingame store is slow</li>
            <li>View title pack metadata, folders, and file metadata without installing the title packs</li>
            <li>(soon) Analytics of player activity on these title packs (historically late, but better late than never)</li>
        </ul>
    </p>
</ReuContainer>

@code {
    private TitleArchiveSnapshot Archive => ArchiveStatus.Snapshot();
}
